PORT=4000
DATABASE_URL=postgresql://tram:tram@localhost:5432/tram_db
# 대전 날씨 표시용 OpenWeatherMap API 키 (없으면 안전 기본값으로 대체됨)
WEATHER_API_KEY=

# JWT 서명 비밀키. 반드시 충분히 긴 랜덤 문자열로 교체할 것 (예: openssl rand -base64 48)
JWT_SECRET=changeme

# 최초 관리자 계정(admin) 시딩 시에만 사용되는 초기 비밀번호. bcrypt로 해싱되어
# admins 테이블에 저장되고, 시딩 이후에는 이 값이 더 이상 쓰이지 않는다.
ADMIN_INITIAL_PASSWORD=changeme

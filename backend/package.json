{
  "name": "tram-server",
  "version": "1.0.0",
  "private": true,
  "description": "대전 트램 시뮬레이션 백엔드 API 서버",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "copy-assets": "mkdir -p dist/data dist/db && cp -r src/data/. dist/data/ && cp src/db/schema.sql dist/db/schema.sql",
    "start": "node dist/index.js",
    "dev": "ts-node --watch src/index.ts",
    "seed": "ts-node src/db/seed.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
